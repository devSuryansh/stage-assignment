# --- Free chat (recommended) ---
# https://console.groq.com/keys  (no credit card)
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Optional: force chat backend (groq | huggingface)
# CHAT_PROVIDER=groq

# --- Optional Hugging Face (paid after ~$0.10/mo free credits) ---
# Only needed if you want HF routing / Kontext image edits.
# HF_TOKEN=
# HF_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct:fastest
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# HF_IMAGE_EDIT_MODEL=black-forest-labs/FLUX.1-Kontext-dev
# Set to 1 to prefer HF images over free Pollinations flux
# HF_IMAGES=0

# Images default to free Pollinations flux (no key).
# IMAGE_PROVIDER=pollinations

# Portable job storage (auto /tmp/data on Vercel when unset)
DATA_DIR=data

# Required on Vercel: durable job store (create via `vercel blob create-store`)
# Local filesystem is fine without this; serverless instances do not share /tmp.
# BLOB_READ_WRITE_TOKEN=
