# Chat via FreeLLMAPI (failover router). Pin a real model — auto:smart can silently stub.
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=freellmapi-your-unified-key
FREELLMAPI_CHAT_MODEL=gemini-3.5-flash

# Optional direct Gemini chat fallback when FreeLLMAPI is down
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-2.5-flash

# Images: Pollinations nanobanana (keyed) with reference conditioning
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=nanobanana

# Portable job storage (use /tmp/data on Vercel)
DATA_DIR=data
